#!/usr/bin/env python3
"""
Interactive SREP Config Generator for Acer AN515-54
Creates a safe, model-specific SREP config from BIOS analysis.

Usage:
    python3 generate_config.py
    python3 generate_config.py --help
"""

import sys
from datetime import datetime

class SREPConfigGenerator:
    TEMPLATE = """# SREP Configuration for Acer AN515-54 (Insyde v1.33)
# Auto-generated by generate_config.py
# Model: {model}
# BIOS version: {bios_version}
# Date: {date}
#
# WARNING: This config applies patches to runtime firmware in RAM only.
# Changes are TEMPORARY and will not persist across reboot.
#

{operations}

Op End
"""

    def __init__(self):
        self.operations = []
        self.model = "AN515-54"
        self.bios_version = "Insyde v1.33"

    def add_setup_loader(self):
        self.operations.append("Op Loaded\nSetupUtility")

    def add_offset_patch(self, offset, new_bytes, description=""):
        comment = f"# {description}" if description else ""
        self.operations.append(f"{comment}\nOp FastestPatch\nOffset\n{offset}\n{new_bytes}")

    def add_pattern_patch(self, pattern, replacement, description=""):
        comment = f"# {description}" if description else ""
        self.operations.append(f"{comment}\nOp FastPatch\nPattern\n{pattern}\n{replacement}")

    def add_regex_patch(self, regex_pattern, replacement, description=""):
        comment = f"# {description}" if description else ""
        self.operations.append(f"{comment}\nOp Patch\nPattern\n{regex_pattern}\n{replacement}")

    def add_guid_load(self, guid, description=""):
        comment = f"# {description}" if description else ""
        self.operations.append(f"{comment}\nOp LoadGUIDandSavePE\n{guid}")

    def generate(self):
        ops = "\n\n".join(self.operations)
        return self.TEMPLATE.format(
            model=self.model,
            bios_version=self.bios_version,
            date=datetime.now().isoformat(),
            operations=ops,
        )

    def interactive_mode(self):
        print("=" * 70)
        print("INTERACTIVE SREP CONFIG GENERATOR")
        print("Acer AN515-54 Insyde v1.33")
        print("=" * 70)
        print()
        print("This tool helps you create a safe SREP config from BIOS analysis.")
        print("IMPORTANT: You should already have extracted your BIOS file and found the actual patch values.")
        print()

        response = input("Do you have the BIOS pattern values ready? (yes/no): ").strip().lower()
        if response not in ["yes", "y"]:
            print("Please:")
            print("  1. Download the BIOS package from Acer support")
            print("  2. Extract the firmware image")
            print("  3. Open it in UEFITool")
            print("  4. Identify the Setup module and patch bytes")
            print("  5. Run this script again")
            return

        self.add_setup_loader()

        while True:
            print("-" * 70)
            print("Patch Menu:")
            print("  1. Add offset-based patch")
            print("  2. Add pattern-based patch")
            print("  3. Add regex patch")
            print("  4. Add GUID loader")
            print("  5. Finish and save config")
            print()
            choice = input("Choose option (1-5): ").strip()

            if choice == "1":
                offset = input("  Offset (hex, e.g., 0x1234): ").strip()
                new_bytes = input("  New bytes (hex, e.g., AABBCCDD): ").strip().upper()
                desc = input("  Description (optional): ").strip()
                self.add_offset_patch(offset, new_bytes, desc)
                print("  ✓ Offset patch added")
            elif choice == "2":
                pattern = input("  Search pattern (hex): ").strip().upper()
                replacement = input("  Replacement (hex): ").strip().upper()
                desc = input("  Description (optional): ").strip()
                self.add_pattern_patch(pattern, replacement, desc)
                print("  ✓ Pattern patch added")
            elif choice == "3":
                regex = input("  Regex pattern (use . for any byte): ").strip().upper()
                replacement = input("  Replacement (hex): ").strip().upper()
                desc = input("  Description (optional): ").strip()
                self.add_regex_patch(regex, replacement, desc)
                print("  ✓ Regex patch added")
            elif choice == "4":
                guid = input("  GUID: ").strip()
                desc = input("  Description (optional): ").strip()
                self.add_guid_load(guid, desc)
                print("  ✓ GUID loader added")
            elif choice == "5":
                break
            else:
                print("Invalid choice. Please try again.")

        filename = "SREP_Acer_AN51554_Custom.cfg"
        with open(filename, "w", encoding="utf-8") as f:
            f.write(self.generate())

        print()
        print("=" * 70)
        print(f"Config saved to: {filename}")
        print("=" * 70)
        print()
        print("Next steps:")
        print("  1. Copy this file to your USB root")
        print("  2. Boot the USB on the Acer AN515-54")
        print("  3. Check SREP.log after each run")
        print()


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ["--help", "-h"]:
        print("SREP Config Generator for Acer AN515-54")
        print()
        print("Usage:")
        print("  python3 generate_config.py")
        print("  python3 generate_config.py --help")
        return

    SREPConfigGenerator().interactive_mode()

if __name__ == "__main__":
    main()














































































































































































